# Copy this file to .env.local and fill in real values.
# Expo loads .env.local automatically.
#
# IMPORTANT: every EXPO_PUBLIC_ value is embedded in the client bundle.
# Treat these as public/client-side values. Do not put private server
# credentials here; proxy sensitive calls through a backend for production.

# OpenRouter: AI suggestions, board interpretation, transcript mapping.
EXPO_PUBLIC_OPENROUTER_API_KEY=aaah
# Optional. Defaults to google/gemini-3.1-flash-lite in config/api.ts.
# Must be a vision-capable OpenRouter model.
EXPO_PUBLIC_BOARD_INTERPRETATION_MODEL=google/gemini-3.1-flash-lite

# OpenSymbols symbol search.
EXPO_PUBLIC_OPENSYMBOLS_SECRET=your-opensymbols-secret

# ElevenLabs speech synthesis.
EXPO_PUBLIC_ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Google sign-in on native builds. See AUTH_SETUP.md.
# Not required for web sign-in or Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Local-only evaluation script (scripts/evaluate-board-drawing.mjs).
# This is NOT read by the Expo app and is not bundled. Use a separate
# server-side key when running the evaluation harness.
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
